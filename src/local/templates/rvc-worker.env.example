# Copy this file to rvc-worker.env in the same local/ directory.
# Fill the NEW InstaBox Private Port Token and Worker Key locally.
# Never commit rvc-worker.env or paste its values into chat.
RVC_BASE_URL=https://YOUR-PRIVATE-PORT.instabox.tech
RVC_PORT_TOKEN=ibp_REPLACE_WITH_ROTATED_TOKEN
RVC_WORKER_KEY=REPLACE_WITH_WORKER_KEY
RVC_MODEL=Fp231.pth
RVC_F0_METHOD=rmvpe
# This must match /health.separator_profile on the InstaBox Worker.
RVC_SEPARATOR_PROFILE=mel-vocals
